--- /dev/null
+++ b/src/styles/base/modal-showcase.tsx
@@ -0,0 +1,37 @@
+import { useState, type CSSProperties } from "react";
+import { Button } from "../../components/Button";
+import { Dialog } from "../../components/Dialog";
+import { Slider } from "../../components/Slider";
+import { Select } from "../../components/Select";
+
+export function ModalShowcase() {
+  const [open, setOpen] = useState(false);
+  const [nested, setNested] = useState(false);
+  const [value, setValue] = useState("standard");
+  const [seconds, setSeconds] = useState(8);
+  const options = [
+    { value: "standard", label: "标准" },
+    { value: "detail", label: "精细 · 超长工作流名称与上下文承接对照档位" },
+    { value: "fast", label: "快速" },
+  ];
+  return <>
+    <Button onClick={() => setOpen(true)}>打开键盘交互示例</Button>
+    <Dialog open={open} title="键盘交互示例" onClose={() => setOpen(false)}>
+      <div style={{ display: "grid", gap: 16 }}>
+        <label className="tc-control tc-text"><input aria-label="示例名称" placeholder="示例名称" /></label>
+        <Select value={value} options={options} onChange={setValue} ariaLabel="示例档位" />
+        <Select value={value} options={options} onChange={setValue} ariaLabel="搜索档位" searchable />
+        <div style={{ width: 280, maxWidth: "100%", height: 66, overflow: "hidden", display: "grid", gridTemplateColumns: "minmax(0,1fr) minmax(0,1fr)", gap: 12, alignItems: "center", "--tc-control-w": "100%" } as CSSProperties}>
+          <Select value={value} options={options} onChange={setValue} ariaLabel="窄栏档位" />
+          <Slider value={seconds} min={1} max={60} onChange={setSeconds} ariaLabel="示例秒数" />
+        </div>
+        <Slider value={8} disabled onChange={() => {}} ariaLabel="禁用秒数" />
+        <Button disabled>不可用操作</Button>
+        <Button onClick={() => setNested(true)}>打开嵌套弹窗</Button>
+      </div>
+      <Dialog open={nested} title="嵌套弹窗" onClose={() => setNested(false)}>
+        <Button onClick={() => setNested(false)}>返回上层</Button>
+      </Dialog>
+    </Dialog>
+  </>;
+}
